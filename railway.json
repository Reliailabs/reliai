{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "postgres": {
      "type": "postgres",
      "engines": {
        "postgres": "16"
      },
      "settings": {
        "database": "reliai",
        "user": "reliai",
        "password": {
          "$fromEnv": "POSTGRES_PASSWORD"
        }
      }
    },
    "redis": {
      "type": "redis",
      "engines": {
        "redis": "7"
      }
    },
    "api": {
      "type": "docker",
      "docker": {
        "dockerfile": "apps/api/Dockerfile",
        "context": "."
      },
      "env": {
        "DATABASE_URL": {
          "$fromService": {
            "name": "postgres",
            "type": "postgres",
            "field": "CONNECTION_STRING"
          }
        },
        "REDIS_URL": {
          "$fromService": {
            "name": "redis",
            "type": "redis",
            "field": "HOST"
          }
        },
        "API_KEY_HASH_SECRET": {
          "$fromEnv": "API_KEY_HASH_SECRET"
        },
        "AUTH_SESSION_HASH_SECRET": {
          "$fromEnv": "AUTH_SESSION_HASH_SECRET"
        },
        "RELIAI_DEV_AUTH_ENABLED": "true"
      },
      "ports": [
        {
          "port": 8000,
          "handler": "http"
        }
      ],
      "healthcheckPath": "/api/v1/health",
      "healthcheckInterval": 10
    },
    "web": {
      "type": "docker",
      "docker": {
        "dockerfile": "apps/web/Dockerfile",
        "context": "."
      },
      "env": {
        "API_URL": {
          "$fromService": {
            "name": "api",
            "type": "docker",
            "field": "URL"
          }
        },
        "NEXT_PUBLIC_API_URL": {
          "$fromService": {
            "name": "api",
            "type": "docker",
            "field": "URL"
          }
        },
        "APP_URL": {
          "$fromEnv": "APP_URL"
        },
        "NEXT_PUBLIC_APP_URL": {
          "$fromEnv": "APP_URL"
        }
      },
      "ports": [
        {
          "port": 3000,
          "handler": "http"
        }
      ]
    }
  },
  "volumes": {
    "postgres_data": {
      "type": "postgres",
      "mountPoint": "/var/lib/postgresql/data"
    }
  }
}
