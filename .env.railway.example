# Reliai Railway Environment Variables
# Copy this file to .env.railway and fill in your values

# Secret keys - generate with: openssl rand -base64 32
API_KEY_HASH_SECRET=your-secret-key-here
AUTH_SESSION_HASH_SECRET=your-session-secret-here

# App URL (Railway will assign this automatically)
APP_URL=https://your-app.railway.app

# Optional: WorkOS for production auth
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_REDIRECT_URI=https://your-app.railway.app/api/auth/callback

# Database settings (managed by Railway - do not modify)
# POSTGRES_HOST=...
# POSTGRES_PORT=...
# POSTGRES_USER=...
# POSTGRES_PASSWORD=...
# POSTGRES_DB=...

# Redis settings (managed by Railway - do not modify)
# REDIS_HOST=...
# REDIS_PORT=...
# REDIS_URL=...
